# .dockerignore — files excluded from Docker build context

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
.env/

# Git
.git/
.gitignore

# DVC cache (keep .dvc files, exclude the cache)
.dvc/cache/
.dvc/tmp/

# IDE and OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Tests
tests/
pytest_cache/
.pytest_cache/
htmlcov/
.coverage

# Notebooks
*.ipynb
*.ipynb_checkpoints/

# Logs
*.log
logs/

# Large data files (mount at runtime or bake into image as needed)
# data/raw/ is kept so the API can access it if needed
